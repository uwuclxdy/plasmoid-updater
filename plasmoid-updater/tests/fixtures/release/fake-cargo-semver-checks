#!/usr/bin/env bash
# Stands in for cargo-semver-checks: records the call, then exits with
# $FAKE_SEMVER_EXIT (100 is the tool's deny-level-violations status), so the
# script's handling of each outcome is observable without the real tool or the
# network. $FAKE_SEMVER_EXIT_MAJOR / _MINOR / _PATCH override that per release
# type, so a case can make `--release-type patch` exit 100 while `minor` exits
# 0 (the patch-then-minor re-check).
set -euo pipefail
printf '%s\n' "$*" >>"${FAKE_SEMVER_LOG:?}"
release_type=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --release-type)
      release_type="${2:-}"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done
exit_code="${FAKE_SEMVER_EXIT:-0}"
case "$release_type" in
  major) [ -n "${FAKE_SEMVER_EXIT_MAJOR:-}" ] && exit_code="$FAKE_SEMVER_EXIT_MAJOR" ;;
  minor) [ -n "${FAKE_SEMVER_EXIT_MINOR:-}" ] && exit_code="$FAKE_SEMVER_EXIT_MINOR" ;;
  patch) [ -n "${FAKE_SEMVER_EXIT_PATCH:-}" ] && exit_code="$FAKE_SEMVER_EXIT_PATCH" ;;
esac
exit "$exit_code"
