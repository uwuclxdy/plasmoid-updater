#!/usr/bin/env bash
# Stands in for git on release.sh's PATH: delegates to the real git except
# when $FAKE_GIT_FAIL_CMD names the subcommand (`ls-remote`, `merge-base`,
# `grep`, ...), which then prints a simulated failure and exits with
# $FAKE_GIT_FAIL_RC (default 1), so a case can observe the script stopping
# with a message instead of reading the failure as "nothing found".
set -euo pipefail
if [ -n "${FAKE_GIT_FAIL_CMD:-}" ] && [ "${1:-}" = "$FAKE_GIT_FAIL_CMD" ]; then
  echo "git: simulated $1 failure" >&2
  exit "${FAKE_GIT_FAIL_RC:-1}"
fi
exec /usr/bin/git "$@"
