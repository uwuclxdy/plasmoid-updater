#!/usr/bin/env bash
# Stands in for the gh CLI: authenticated, no release yet (bar the tags in
# $FAKE_GH_RELEASES), and an
# autogenerated-notes body with no PR links so the --notes coverage gate has
# nothing to require. Every call lands in $FAKE_GH_LOG.
set -euo pipefail
printf '%s\n' "$*" >>"${FAKE_GH_LOG:?}"
case "${1:-}" in
  auth) exit 0 ;;
  release)
    case "${2:-}" in
      view)
        # $FAKE_GH_RELEASES lists the tags that already have a release
        case " ${FAKE_GH_RELEASES:-} " in
          *" ${3:-} "*) exit 0 ;;
        esac
        exit 1
        ;;
      create | edit)
        cat >/dev/null
        exit 0
        ;;
    esac
    ;;
  api) printf "## What's Changed\n\n## Full Changelog\n\n**Full Changelog**: see tags\n" ;;
esac
exit 0
